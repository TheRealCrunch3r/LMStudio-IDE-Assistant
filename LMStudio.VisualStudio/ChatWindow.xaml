<UserControl x:Class="LMStudio.VisualStudio.ChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ChatView des LM Studio AI Assistant.
      Struktur: Statuszeile / Scrollbare Chat-Ausgabe (RichTextBox) / Eingabezeile.
      Bewusst ohne fremde Theming-Pakete – VS-Chrome umrahmt das Fenster bereits.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zeile 0: Status + Einstellungs-Button -->
        <DockPanel Grid.Row="0" Margin="8,6,8,2" LastChildFill="True">
            <Button x:Name="SettingsButton"
                    DockPanel.Dock="Right"
                    Content="⚙ Einstellungen…"
                    Padding="10,3"
                    Click="OnOpenSettings" />
            <TextBlock x:Name="StatusText"
                       Text="LM Studio: nicht verbunden"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="#FF666666"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Zeile 1: Chat-Ausgabe (read-only RichTextBox mit FlowDocument) -->
        <RichTextBox x:Name="ChatOutput"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Margin="6,2">
            <FlowDocument>
                <!-- Willkommens-Text wird im Code-Behind ergänzt (sprachsicherer als hartcodiert hier) -->
            </FlowDocument>
        </RichTextBox>

        <!-- Zeile 2: Eingabe + Senden -->
        <Grid Grid.Row="2" Margin="8,2,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptInput"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     MinHeight="34"
                     ToolTip="Prompt für LM Studio eingeben (Enter sendet)"
                     KeyDown="OnPromptKeyDown" />

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Senden ➤"
                    Margin="6,0,0,0"
                    Padding="14,5"
                    IsDefault="True"
                    Click="OnSendClick" />
        </Grid>
    </Grid>
</UserControl>
