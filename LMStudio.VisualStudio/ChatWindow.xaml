<UserControl x:Class="LMStudio.VisualStudio.ChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      LM Studio AI Assistant chat view.
      Structure: status bar / scrollable chat output (RichTextBox) / input line.
      Intentionally no external theming packages — the window is already framed by VS Chrome.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Status + Settings button -->
        <DockPanel Grid.Row="0" Margin="8,6,8,2" LastChildFill="True">
            <Button x:Name="SettingsButton"
                    DockPanel.Dock="Right"
                    Content="⚙ Settings…"
                    Padding="10,3"
                    Click="OnOpenSettings" />
            <TextBlock x:Name="StatusText"
                       Text="LM Studio: not connected"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="#FF666666"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Row 1: Chat output (read-only RichTextBox with FlowDocument) -->
        <RichTextBox x:Name="ChatOutput"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Margin="6,2">
            <FlowDocument>
                <!-- Welcome text is added by code-behind (more language-safe than hardcoding here) -->
            </FlowDocument>
        </RichTextBox>

        <!-- Row 2: Input + Send -->
        <Grid Grid.Row="2" Margin="8,2,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptInput"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     MinHeight="34"
                     ToolTip="Enter prompt for LM Studio (Enter sends)"
                     KeyDown="OnPromptKeyDown" />

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send ➤"
                    Margin="6,0,0,0"
                    Padding="14,5"
                    IsDefault="True"
                    Click="OnSendClick" />
        </Grid>
    </Grid>
</UserControl>
