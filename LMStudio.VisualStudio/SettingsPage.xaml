<Window x:Class="LMStudio.VisualStudio.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LM Studio AI Assistant – Settings"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">

        <TextBlock Text="Server URL (base)" FontWeight="SemiBold" Margin="0,0,0,3" />
        <TextBox x:Name="BaseUrlBox" MinHeight="28" VerticalContentAlignment="Center" ToolTip="e.g. http://localhost:1234" />

        <TextBlock Text="Model ID (leave empty = server default)" FontWeight="SemiBold" Margin="0,12,0,3" />
        <TextBox x:Name="ModelBox" MinHeight="28" VerticalContentAlignment="Center" ToolTip="e.g. qwen-qwen3-4b-instruct-2507" />

        <Button x:Name="TestButton" Content="Test connection…" Margin="0,16,0,0" Padding="10,5" Click="OnTestClick" />
        <TextBlock x:Name="TestResultText" TextWrapping="Wrap" Margin="2,6,2,0" Foreground="#FF444444" />

        <Separator Margin="0,18,0,12" />

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="Cancel" Width="90" Padding="6" Click="OnCancelClick" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="OkButton" Content="Save" Width="90" Padding="6" Click="OnOkClick" IsDefault="True" />
        </DockPanel>
    </StackPanel>
</Window>
